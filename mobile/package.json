{
  "name": "liuying-mobile",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "sync": "pnpm build && cap sync && node scripts/prepare-native.mjs",
    "sync:ios": "pnpm build && cap sync ios && node scripts/prepare-native.mjs",
    "check:ios": "node scripts/check-ios.mjs",
    "test:ios": "bash scripts/test-ios.sh",
    "test:native": "node scripts/native-tests.mjs",
    "test:network": "node scripts/native-tests.mjs --network",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
